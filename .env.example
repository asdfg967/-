# ===== 访问密码 =====
# 用户打开应用时需要输入的密码
APP_PASSWORD=student2024

# ===== Supabase 数据库 =====
# 在 Supabase 项目后台 Project Settings -> API 获取
COZE_SUPABASE_URL=https://xxxxxxxx.supabase.co
COZE_SUPABASE_ANON_KEY=eyJhbGciOi...你的-anon-key
# service_role_key（仅服务端使用，不要暴露到前端）
COZE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...你的-service-role-key

# ===== 对象存储（日记图片上传，S3 兼容）=====
COZE_BUCKET_ENDPOINT_URL=https://your-s3-endpoint
COZE_BUCKET_NAME=your-bucket-name
COZE_BUCKET_ACCESS_KEY_ID=your-access-key-id
COZE_BUCKET_SECRET_ACCESS_KEY=your-secret-access-key
COZE_BUCKET_PUBLIC_URL=https://your-public-url-base

# ===== AI 模型（coze-coding-dev-sdk 自动注入，无需手动配置）=====
# 通知文字提取 / 截图 OCR 由平台自动提供凭证

# ===== 运行环境（平台自动注入）=====
# DEPLOY_RUN_PORT=5000
# COZE_PROJECT_ENV=PROD
